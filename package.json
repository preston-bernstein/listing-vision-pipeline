{
  "name": "listing-vision-pipeline",
  "version": "0.1.0",
  "description": "Vision-powered listing pipeline with real-time alerts",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check:secrets": "node scripts/check-forbidden-strings.mjs",
    "analyze": "fallow",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fallow": "^3.14.0",
    "globals": "^17.9.0",
    "knip": "^6.32.2",
    "typescript-eslint": "^8.66.0"
  }
}

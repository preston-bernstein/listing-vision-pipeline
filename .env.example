# Ollama configuration — point this at your own Ollama-compatible endpoint.
# There is no runtime fallback (see packages/core/src/score/visionClient.ts) —
# this variable is required and validated as a well-formed http(s) URL.
OLLAMA_HOST=http://localhost:11434

# Database
DATABASE_URL=file:./data/app.db

# Alert settings
ALERT_SCORE_THRESHOLD=70
ALERT_LIVE_SEND=false

# Vision API
VISION_API_STYLE=ollama

# Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Server
PORT=3000
